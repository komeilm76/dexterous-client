{
  "name": "dexterous-client",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev:raw": "vite --host",
    "dev": "concurrently \"bun run generate-env-new:watch\" \"bun run generate-head-new:watch\" \"bun run generate-pwa:watch\" \"bun run generate-palette-new:watch\" \"bun run generate-icon-new:watch\" \"bun run generate-worker:watch\"  \"vite --host\"",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "generate-worker": "npx esbuild ./src/micro/worker/index.ts --bundle --outfile=./public/worker/index.js --platform=browser --target=es2018",
    "generate-worker:watch": "npx esbuild ./src/micro/services/worker/inWorker/index.ts --bundle --outfile=./public/worker/index.js --platform=browser --target=es2018 --watch",
    "generate-palette:watch": "bun --watch ./src/micro/services/palette/index.ts",
    "generate-palette-new:watch": "bun --watch ./src/micro-service/services/palette/src/index.ts",
    "generate-icon:watch": "bun --watch ./src/micro/services/icon/index.ts",
    "generate-icon-new:watch": "bun --watch ./src/micro-service/services/icon/src/index.ts",
    "generate-pwa:watch": "bun --watch ./src/micro/services/pwa/index.ts",
    "generate-env:watch": "bun --watch --env-file=.env.production ./src/micro/services/env/index.ts",
    "generate-env-new:watch": "bun --watch --env-file=.env.production ./src/micro-service/services/env/src/index.ts",
    "generate-head:watch": "bun --watch ./src/micro/services/head/index.ts",
    "generate-head-new:watch": "bun --watch ./src/micro-service/services/head/src/index.ts"
  },
  "dependencies": {
    "@alova/adapter-axios": "^2.0.16",
    "@fontsource/beiruti": "^5.2.8",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/gulzar": "^5.2.8",
    "@fontsource/lalezar": "^5.2.7",
    "@fontsource/noto-nastaliq-urdu": "^5.2.8",
    "@fontsource/redacted-script": "^5.2.8",
    "@fontsource/roboto": "5.2.7",
    "@mdi/font": "7.4.47",
    "@tailwindcss/vite": "^4.1.17",
    "@types/lodash": "^4.17.20",
    "@vee-validate/zod": "^4.15.1",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vueuse/motion": "^3.0.3",
    "alova": "^3.3.4",
    "axios": "^1.12.2",
    "https-localhost": "^4.7.1",
    "km-api": "^0.1.0",
    "km-icon": "^0.0.19",
    "km-manifest": "^0.0.5",
    "km-modal": "^0.0.11",
    "km-palette": "^0.1.3",
    "km-storage": "^0.3.0",
    "km-traversal": "^1.1.8",
    "km-worker": "^0.0.3",
    "lodash": "^4.17.21",
    "mkcert": "^3.2.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "sharp-ico": "^0.1.5",
    "tailwindcss": "^4.1.17",
    "ua-parser-js": "^2.0.5",
    "uuid": "^13.0.0",
    "vee-validate": "^4.15.1",
    "vite-plugin-mkcert": "^1.17.8",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1",
    "vue-use": "^0.2.0",
    "vuetify": "^3.10.1",
    "zipson": "^0.2.12",
    "zod": "^3.25.67",
    "zod-to-json-schema": "^3.25.1",
    "zod-to-ts": "^2.0.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-config-vuetify": "^4.2.0",
    "fs-jetpack": "^5.1.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.7.4",
    "sass-embedded": "^1.92.1",
    "typescript": "~5.9.2",
    "unplugin-fonts": "^1.4.0",
    "unplugin-vue-components": "^29.0.0",
    "unplugin-vue-router": "^0.15.0",
    "vite": "^7.1.5",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vite-plugin-vuetify": "^2.1.2",
    "vue-tsc": "^3.0.7"
  }
}
