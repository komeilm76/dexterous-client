{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "default": "./schema.json",
      "type": "string"
    },
    "baseUrl": {
      "default": "http://localhost:8097",
      "type": "string"
    },
    "setting": {
      "type": "object",
      "properties": {
        "font": {
          "type": "object",
          "properties": {
            "default": {
              "default": "Beiruti",
              "anyOf": [
                {
                  "type": "string",
                  "const": "Vazirmatn"
                },
                {
                  "type": "string",
                  "const": "Noto Nastaliq Urdu"
                },
                {
                  "type": "string",
                  "const": "Roboto"
                },
                {
                  "type": "string",
                  "const": "Beiruti"
                },
                {
                  "type": "string",
                  "const": "Gulzar"
                },
                {
                  "type": "string",
                  "const": "Lalezar"
                },
                {
                  "type": "string",
                  "const": "Caveat"
                }
              ]
            },
            "fonts": {
              "default": {
                "Beiruti": true,
                "Noto Nastaliq Urdu": false,
                "Caveat": false,
                "Gulzar": false,
                "Lalezar": false,
                "Roboto": false,
                "Vazirmatn": false
              },
              "type": "object",
              "propertyNames": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "Vazirmatn"
                  },
                  {
                    "type": "string",
                    "const": "Noto Nastaliq Urdu"
                  },
                  {
                    "type": "string",
                    "const": "Roboto"
                  },
                  {
                    "type": "string",
                    "const": "Beiruti"
                  },
                  {
                    "type": "string",
                    "const": "Gulzar"
                  },
                  {
                    "type": "string",
                    "const": "Lalezar"
                  },
                  {
                    "type": "string",
                    "const": "Caveat"
                  }
                ]
              },
              "additionalProperties": {
                "type": "boolean"
              },
              "required": [
                "Vazirmatn",
                "Noto Nastaliq Urdu",
                "Roboto",
                "Beiruti",
                "Gulzar",
                "Lalezar",
                "Caveat"
              ]
            }
          },
          "required": [
            "default",
            "fonts"
          ],
          "additionalProperties": false
        },
        "language": {
          "type": "object",
          "properties": {
            "default": {
              "default": "en",
              "anyOf": [
                {
                  "type": "string",
                  "const": "en"
                },
                {
                  "type": "string",
                  "const": "fa"
                }
              ]
            },
            "languages": {
              "default": {
                "en": true,
                "fa": false
              },
              "type": "object",
              "propertyNames": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "en"
                  },
                  {
                    "type": "string",
                    "const": "fa"
                  }
                ]
              },
              "additionalProperties": {
                "type": "boolean"
              },
              "required": [
                "en",
                "fa"
              ]
            }
          },
          "required": [
            "default",
            "languages"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "font",
        "language"
      ],
      "additionalProperties": false
    },
    "appVersion": {
      "default": "0.0.0",
      "type": "string"
    },
    "buildHash": {
      "default": "base-hash",
      "type": "string"
    }
  },
  "required": [
    "$schema",
    "baseUrl",
    "setting",
    "appVersion",
    "buildHash"
  ],
  "additionalProperties": false
}